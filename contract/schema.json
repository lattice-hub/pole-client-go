{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pole:thin-sdk:target-envelope:1.0.0:schema",
  "title": "Pole TargetEnvelope v1 input schema",
  "description": "Schema for the normalized logical object. Constructor input normalization, full original_endpoint validation, and header conformance require the normative specification and conformance vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "service"
  ],
  "properties": {
    "namespace": {
      "$ref": "#/$defs/requiredField"
    },
    "service": {
      "$ref": "#/$defs/requiredField"
    },
    "protocol": {
      "$ref": "#/$defs/optionalField"
    },
    "group": {
      "$ref": "#/$defs/optionalField"
    },
    "service_version": {
      "$ref": "#/$defs/optionalField"
    },
    "method": {
      "$ref": "#/$defs/optionalField"
    },
    "original_endpoint": {
      "allOf": [
        {
          "$ref": "#/$defs/optionalField"
        },
        {
          "pattern": "^(?:[^:\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000%/\\\\\\[\\]@?#]+|\\[[0-9A-Fa-f:.]+\\]):(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        }
      ]
    }
  },
  "$defs": {
    "requiredField": {
      "$ref": "#/$defs/normalizedField"
    },
    "optionalField": {
      "$ref": "#/$defs/normalizedField"
    },
    "normalizedField": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ud800-\\udfff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]*[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ud800-\\udfff])?$"
    }
  }
}
