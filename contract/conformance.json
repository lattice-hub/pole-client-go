      "input": {"namespace": "", "service": "orders"},
      "diagnostic": "REQUIRED_FIELD_EMPTY"
    },
    {
      "name": "blank_service",
      "input": {"namespace": "default", "service": "　"},
      "diagnostic": "REQUIRED_FIELD_EMPTY"
    },
    {
      "name": "line_feed_control",
      "input": {"namespace": "def\nault", "service": "orders"},
      "diagnostic": "CONTROL_CHARACTER"
    },
    {
      "name": "next_line_control",
      "input": {"namespace": "default", "service": "orders"},
      "diagnostic": "CONTROL_CHARACTER"
    },
    {
      "name": "endpoint_missing_port",
      "input": {"namespace": "default", "service": "orders", "original_endpoint": "orders.internal"},
