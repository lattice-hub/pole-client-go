{
  "contract": "pole-target-envelope",
  "contract_version": "1.0.0",
  "envelope_version": "1",
  "valid": [
    {
      "name": "minimal_unicode_trim",
      "input": {
        "namespace": " default　",
        "service": " orders "
      },
      "normalized": {
        "namespace": "default",
        "service": "orders"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"]
      ]
    },
    {
      "name": "complete",
      "input": {
        "namespace": "production",
        "service": "catalog",
        "protocol": "grpc",
        "group": "blue",
        "service_version": "v1",
        "method": "GetProduct",
        "original_endpoint": "catalog.internal:8080"
      },
      "normalized": {
        "namespace": "production",
        "service": "catalog",
        "protocol": "grpc",
        "group": "blue",
        "service_version": "v1",
        "method": "GetProduct",
        "original_endpoint": "catalog.internal:8080"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "production"],
        ["x-pole-target-service", "catalog"],
        ["x-pole-target-protocol", "grpc"],
        ["x-pole-target-group", "blue"],
        ["x-pole-target-service-version", "v1"],
        ["x-pole-target-method", "GetProduct"],
        ["x-pole-original-endpoint", "catalog.internal:8080"]
      ]
    },
    {
      "name": "unicode_header_encoding",
      "input": {
        "namespace": "生产",
        "service": "订单%,服务"
      },
      "normalized": {
        "namespace": "生产",
        "service": "订单%,服务"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "%E7%94%9F%E4%BA%A7"],
        ["x-pole-target-service", "%E8%AE%A2%E5%8D%95%25%2C%E6%9C%8D%E5%8A%A1"]
      ]
    },
    {
      "name": "feff_is_not_whitespace",
      "input": {
        "namespace": "﻿default﻿",
        "service": "orders"
      },
      "normalized": {
        "namespace": "﻿default﻿",
        "service": "orders"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "%EF%BB%BFdefault%EF%BB%BF"],
        ["x-pole-target-service", "orders"]
      ]
    },
    {
      "name": "ipv4_endpoint",
      "input": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "127.0.0.1:8080"
      },
      "normalized": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "127.0.0.1:8080"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"],
        ["x-pole-original-endpoint", "127.0.0.1:8080"]
      ]
    },
    {
      "name": "ipv6_endpoint",
      "input": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "[::1]:8080"
      },
      "normalized": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "[::1]:8080"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"],
        ["x-pole-original-endpoint", "[::1]:8080"]
      ]
    },
    {
      "name": "ipv4_embedded_ipv6_endpoint",
      "input": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "[::ffff:192.0.2.1]:8080"
      },
      "normalized": {
        "namespace": "default",
        "service": "orders",
        "original_endpoint": "[::ffff:192.0.2.1]:8080"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"],
        ["x-pole-original-endpoint", "[::ffff:192.0.2.1]:8080"]
      ]
    },
    {
      "name": "empty_optional_fields_are_omitted",
      "input": {
        "namespace": "default",
        "service": "orders",
        "protocol": " ",
        "group": "",
        "service_version": "　",
        "method": "",
        "original_endpoint": ""
      },
      "normalized": {
        "namespace": "default",
        "service": "orders"
      },
      "expected_headers": [
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"]
      ]
    },
    {
      "name": "caller_internal_headers_are_replaced",
      "input": {
        "namespace": "default",
        "service": "orders"
      },
      "base_headers": [
        ["Authorization", "Bearer token"],
        ["X-Pole-Target-Envelope-Version", "999"],
        ["X-Pole-Target-Namespace", "forged"],
        ["x-pole-target-service", "forged"]
      ],
      "normalized": {
        "namespace": "default",
        "service": "orders"
      },
      "expected_headers": [
        ["Authorization", "Bearer token"],
        ["x-pole-target-envelope-version", "1"],
        ["x-pole-target-namespace", "default"],
        ["x-pole-target-service", "orders"]
      ]
    }
  ],
  "invalid": [
