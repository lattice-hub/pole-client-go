  "language_specific_invalid": [
    {
      "name": "isolated_high_surrogate",
      "field": "service",
      "utf16_code_units": ["D800"],
      "diagnostic": "INVALID_UNICODE_SCALAR"
    },
    {
      "name": "isolated_low_surrogate",
      "field": "service",
      "utf16_code_units": ["DC00"],
      "diagnostic": "INVALID_UNICODE_SCALAR"
    }
  ],
  "sidecar_receive": {
    "valid": [
      {
        "name": "minimal",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "orders"]
        ],
        "expected_envelope": {
          "namespace": "default",
          "service": "orders"
        }
      },
      {
        "name": "canonical_unicode",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "%E7%94%9F%E4%BA%A7"],
          ["x-pole-target-service", "%E8%AE%A2%E5%8D%95%25%2C%E6%9C%8D%E5%8A%A1"]
        ],
        "expected_envelope": {
          "namespace": "生产",
          "service": "订单%,服务"
        }
      }
    ],
    "invalid": [
      {
        "name": "missing_version",
        "headers": [
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "orders"]
        ],
        "diagnostic": "MISSING_REQUIRED_HEADER"
      },
      {
        "name": "duplicate_service",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "orders"],
          ["X-Pole-Target-Service", "payments"]
        ],
        "diagnostic": "DUPLICATE_INTERNAL_HEADER"
      },
      {
        "name": "merged_duplicate_value",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "orders,payments"]
        ],
        "diagnostic": "NON_CANONICAL_HEADER_VALUE"
      },
      {
        "name": "unknown_target_header",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "orders"],
          ["x-pole-target-future", "value"]
        ],
        "diagnostic": "UNKNOWN_INTERNAL_HEADER"
      },
      {
        "name": "invalid_percent_escape",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "%GG"]
        ],
        "diagnostic": "NON_CANONICAL_HEADER_VALUE"
      },
      {
        "name": "lowercase_percent_escape",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "%e7%94%9f"]
        ],
        "diagnostic": "NON_CANONICAL_HEADER_VALUE"
      },
      {
        "name": "unnecessary_percent_escape",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "or%64ers"]
        ],
        "diagnostic": "NON_CANONICAL_HEADER_VALUE"
      },
      {
        "name": "invalid_utf8",
        "headers": [
          ["x-pole-target-envelope-version", "1"],
          ["x-pole-target-namespace", "default"],
          ["x-pole-target-service", "%FF"]
        ],
        "diagnostic": "NON_CANONICAL_HEADER_VALUE"
      }
    ]
  }
